{
  "name": "tally",
  "version": "0.1.0",
  "private": true,
  "description": "Tally \u2014 AI revenue recovery agent. Multi-tenant, one engine.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:db": "tsx --test --test-concurrency=1 tests/db/*.test.ts",
    "db:push": "tsx --env-file-if-exists=.env scripts/db-push.ts",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "worker": "tsx --env-file-if-exists=.env scripts/run-worker.ts",
    "batch": "tsx --env-file-if-exists=.env scripts/batch-test.ts",
    "clean:batch": "tsx --env-file-if-exists=.env scripts/clean-batch.ts",
    "stack:up": "bash scripts/start-local-stack.sh",
    "stack:down": "docker rm -f tally-pg tally-postgrest",
    "ai:key": "tsx --env-file-if-exists=.env scripts/ai-key.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "@base-ui/react": "^1.6.0",
    "@supabase/supabase-js": "^2.58.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "next": "^15.5.0",
    "next-themes": "^0.4.6",
    "razorpay": "^2.9.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.8.0",
    "resend": "^6.1.0",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "twilio": "^5.10.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "pg": "^8.13.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
