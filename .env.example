# ─── Tally platform credentials ───────────────────────────────────────────────
# These are the credentials TALLY ITSELF needs to run.
# A merchant's own Razorpay keys / WhatsApp number are NOT here — those are
# entered through the onboarding UI and stored encrypted in the `merchants` table.
#
# This file is a TEMPLATE and is committed to the repo. Never put real secrets
# here — copy it to `.env` (which is gitignored) and fill that in instead.

# ─── Database ────────────────────────────────────────────────────────────────
# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# Service-role / secret key. Server-side only — bypasses RLS, never expose to
# the browser. Newer projects issue this as `sb_secret_...`.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string — must start with `postgres://`, NOT https://.
# Supabase → Project Settings → Database → Connection string (URI).
# Only needed for `npm run db:push` and the concurrency tests; unused at runtime.
# You can instead paste supabase/schema.sql into the Supabase SQL editor.
SUPABASE_DB_URL=

# ─── Agent brain ─────────────────────────────────────────────────────────────
# Which backend drives the recovery decision engine: anthropic | gemini
# If unset, whichever API key is present is used (Anthropic preferred).
TALLY_LLM_PROVIDER=

# Claude. Leave blank to use Gemini instead.
ANTHROPIC_API_KEY=
# Optional model override. Defaults to claude-opus-5.
ANTHROPIC_MODEL=
# Optional reasoning effort for the Claude path: low | medium | high (default high).
TALLY_AGENT_EFFORT=

# Gemini. Leave blank to use Claude instead.
# Groq (console.groq.com/keys) - the default provider: OpenAI-compatible and
# materially faster than the alternatives, which matters because the case
# panel blocks on these calls while someone waits.
#
# Keys are better held in the ai_keys table, where several can be pooled and a
# throttled one fails over to the next. These are the fallback for a
# deployment that has not been given a pool yet.
GROQ_API_KEY=
# GROQ_MODEL defaults to llama-3.3-70b-versatile
GROQ_MODEL=

GEMINI_API_KEY=
# Optional model override. Defaults to gemini-3.5-flash — the Pro tiers are
# quota-limited on free keys, and the `-latest` aliases return 503 under load.
GEMINI_MODEL=

# ─── Email channel ───────────────────────────────────────────────────────────
# Resend API key. No approval needed, sends instantly.
RESEND_API_KEY=
# Must be on a domain VERIFIED in Resend, or every send is rejected.
# e.g. Tally <hello@yourdomain.com>
RESEND_FROM_EMAIL=

# ─── WhatsApp + Voice (one Twilio account covers both) ───────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Outbound voice calls, e.g. +14155551234. Voice is disabled while this is blank.
TWILIO_PHONE_NUMBER=
# Twilio WhatsApp Sandbox number, e.g. whatsapp:+14155238886
# On a trial account, recipients must send the sandbox join code first.
TWILIO_WHATSAPP_NUMBER=

# ─── Optional stretch: higher-quality Hinglish voice ─────────────────────────
# Leave blank to use Twilio's built-in Polly TTS instead.
ELEVENLABS_API_KEY=

# ─── Credential encryption ───────────────────────────────────────────────────
# Encrypts merchant-supplied credentials (AES-256-GCM) before they are stored.
# Must be 32 bytes, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key makes every already-stored merchant credential unreadable.
CREDENTIAL_ENCRYPTION_KEY=

# ─── Deployment ──────────────────────────────────────────────────────────────
# Public base URL, used to build merchant webhook URLs and dashboard links.
# e.g. https://tally.vercel.app  (no trailing slash)
TALLY_PUBLIC_URL=
# Shared secret protecting /api/cron/worker. Vercel Cron sends this as
# `Authorization: Bearer <value>`. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# ─── Local dev only: your own two test merchants ─────────────────────────────
# A real merchant enters these through the onboarding UI instead. `npm run seed`
# reads them to create Mandate and Swaseekh as local test tenants.
# Use rzp_test_ keys — rzp_live_ keys move real money.
MANDATE_RAZORPAY_KEY_ID=
MANDATE_RAZORPAY_KEY_SECRET=
SWASEEKH_RAZORPAY_KEY_ID=
SWASEEKH_RAZORPAY_KEY_SECRET=
